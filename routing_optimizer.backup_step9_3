# DAY 5 - STEP 5: DISTURBANCE-AWARE ROUTE RISK ENGINE
# ============================================================

def calculate_route_risk(
    weather_risk=0,
    festival_risk=0,
    strike_risk=0,
    road_disruption_risk=0
):
    """
    Calculate route disturbance risk on a 0-100 scale.

    Each input must be between 0 and 100.

    Returns a risk score, risk category and components.
    """

    risks = {
        "weather": float(weather_risk),
        "festival": float(festival_risk),
        "strike": float(strike_risk),
        "road_disruption": float(road_disruption_risk)
    }

    for name, value in risks.items():

        if not math.isfinite(value) or not 0 <= value <= 100:
            raise ValueError(
                f"{name} risk must be between 0 and 100."
            )

    # Weighted risk calculation.
    weights = {
        "weather": 0.30,
        "festival": 0.20,
        "strike": 0.25,
        "road_disruption": 0.25
    }

    weighted_risk = sum(
        risks[name] * weights[name]
        for name in risks
    )

    risk_score = round(weighted_risk, 2)

    if risk_score < 20:
        risk_level = "Low"
    elif risk_score < 40:
        risk_level = "Moderate"
    elif risk_score < 70:
        risk_level = "High"
    else:
        risk_level = "Severe"

    return {
        "risk_score": risk_score,
        "risk_level": risk_level,
        "risk_components": risks,
        "risk_weights": weights
    }


def evaluate_route_candidates(
    routes,
    route_risk_data
):
    """
    Evaluate available routes using their disturbance risk.

    route_risk_data format:

    {
        "route_1": {
            "weather_risk": 20,
            "festival_risk": 30,
            "strike_risk": 0,
            "road_disruption_risk": 10
        }
    }

    Missing route risk data is treated as unknown, not safe.
    """

    if not routes:
        raise ValueError("At least one route is required.")

    if not isinstance(route_risk_data, dict):
        raise TypeError("route_risk_data must be a dictionary.")

    evaluated_routes = []

    for route in routes:

        route_id = route.get("route_id")

        if not route_id:
            raise ValueError("Every route must have a route_id.")

        if route_id not in route_risk_data:
            evaluation = {
                "risk_score": None,
                "risk_level": "Unknown",
                "risk_components": None
            }

        else:
            risk_data = route_risk_data[route_id]

            if not isinstance(risk_data, dict):
                raise ValueError(
                    f"Risk data for {route_id} must be a dictionary."
                )

            evaluation = calculate_route_risk(
                weather_risk=risk_data.get("weather_risk", 0),
                festival_risk=risk_data.get("festival_risk", 0),
                strike_risk=risk_data.get("strike_risk", 0),
                road_disruption_risk=risk_data.get(
                    "road_disruption_risk", 0
                )
            )

        evaluated_routes.append({
            **route,
            "risk_score": evaluation["risk_score"],
            "risk_level": evaluation["risk_level"],
            "risk_components": evaluation["risk_components"]
        })

    return evaluated_routes


def recommend_safest_route(routes):
    """
    Recommend a route using risk, travel time and distance.

    Routes without risk data cannot be recommended as safe.
    """

    if not routes:
        raise ValueError("No routes available.")

    known_routes = [
        route for route in routes
        if route.get("risk_score") is not None
    ]

    if not known_routes:
        raise ValueError(
            "Cannot recommend a safest route: "
            "risk information is unavailable for every route."
        )

    recommended = min(
        known_routes,
        key=lambda route: (
            route["risk_score"],
            route["duration_minutes"],
            route["distance_km"]
        )
    )

    return recommended


# ============================================================
# DAY 5 - STEP 6: INTELLIGENT ROUTE RANKING
# ============================================================

def rank_routes_intelligently(
    routes,
    risk_weight=0.40,
    time_weight=0.35,
    distance_weight=0.25,
    delay_weight=0.0
):
    """
    Rank routes using:
    - Disturbance risk
    - Driving time
    - Distance
    - Additional predicted delay

    All weights must sum to 1.

    Missing risk information makes a route ineligible.
    """

    if not routes:
        raise ValueError("No routes available.")

    weights = {
        "risk": float(risk_weight),
        "time": float(time_weight),
        "distance": float(distance_weight),
        "delay": float(delay_weight)
    }

    for name, weight in weights.items():
        if not math.isfinite(weight) or weight < 0:
            raise ValueError(f"Invalid {name} weight.")

    if not math.isclose(
        sum(weights.values()), 1.0, abs_tol=1e-9
    ):
        raise ValueError("Optimization weights must sum to 1.")

    eligible_routes = []

    for route in routes:

        risk = route.get("risk_score")

        if risk is None:
            continue

        distance = float(route["distance_km"])
        duration = float(route["duration_minutes"])
        delay = float(route.get("additional_delay_minutes", 0))

        values = [risk, distance, duration, delay]

        if not all(math.isfinite(float(v)) for v in values):
            raise ValueError("Route contains non-finite values.")

        if not 0 <= float(risk) <= 100:
            raise ValueError("Risk score must be between 0 and 100.")

        if distance <= 0 or duration < 0 or delay < 0:
            raise ValueError("Invalid distance, time or delay.")

        eligible_routes.append({
            **route,
            "distance_km": distance,
            "duration_minutes": duration,
            "risk_score": float(risk),
            "additional_delay_minutes": delay
        })

    if not eligible_routes:
        raise ValueError(
            "No routes have sufficient risk information."
        )

    minimum_distance = min(
        r["distance_km"] for r in eligible_routes
    )

    minimum_duration = min(
        r["duration_minutes"] for r in eligible_routes
    )

    maximum_delay = max(
        r["additional_delay_minutes"] for r in eligible_routes
    )

    ranked_routes = []

    for route in eligible_routes:

        distance_score = (
            route["distance_km"] / minimum_distance * 100
        )

        time_score = (
            route["duration_minutes"] / minimum_duration * 100
            if minimum_duration > 0 else 0
        )

        delay_score = (
            route["additional_delay_minutes"] / maximum_delay * 100
            if maximum_delay > 0 else 0
        )

        # Lower overall score means a better route.
        optimization_score = (
            route["risk_score"] * weights["risk"]
            + time_score * weights["time"]
            + distance_score * weights["distance"]
            + delay_score * weights["delay"]
        )

        ranked_routes.append({
            **route,

            "distance_score": round(distance_score, 2),

            "time_score": round(time_score, 2),

            "delay_score": round(delay_score, 2),

            "optimization_score": round(
                optimization_score, 2
            )
        })

    ranked_routes.sort(
        key=lambda r: (
            r["optimization_score"],
            r["risk_score"],
            r["duration_minutes"],
            r["distance_km"]
        )
    )

    for index, route in enumerate(ranked_routes):
        route["optimization_rank"] = index + 1

        route["recommended"] = index == 0

    return ranked_routes


def optimize_shipment_route(
    source,
    destination,
    route_risk_data,
    risk_weight=0.40,
    time_weight=0.35,
    distance_weight=0.25,
    delay_weight=0.0
):
    """
    Complete route optimization pipeline.

    Generates routes, evaluates risk and ranks them.
    """

    routes = generate_route_candidates(
        source,
        destination,
        alternatives=3
    )

    evaluated_routes = evaluate_route_candidates(
        routes,
        route_risk_data
    )

    ranked_routes = rank_routes_intelligently(
        evaluated_routes,
        risk_weight=risk_weight,
        time_weight=time_weight,
        distance_weight=distance_weight,
        delay_weight=delay_weight
    )

    recommended_route = ranked_routes[0]

    return {
        "routes": ranked_routes,

        "recommended_route": recommended_route,

        "total_routes_generated": len(routes),

        "total_routes_evaluated": len(ranked_routes),

        "optimization_method": "Weighted multi-criteria ranking"
    }


# ============================================================
# DAY 5 - STEP 7: ROUTE CONDITION INTEGRATION
# ============================================================

def integrate_route_conditions(
    routes,
    route_conditions,
    use_verified_ml=True
):
    """
    Add real shipment-condition data to each candidate route.

    Parameters
    ----------
    routes : list
        Route candidates returned by generate_route_candidates().

    route_conditions : dict
        Dictionary keyed by route_id.

        Each route must provide:
        temperature, rainfall, wind_speed,
        severe_weather, festival_nearby, rss_disturbance,
        weather_risk, festival_risk, strike_risk,
        road_disruption_risk.

        Optional:
        shipment_id, route_segment.

    use_verified_ml : bool
        Use the verified-data Random Forest model only
        when it has actually been trained.

    Returns
    -------
    list
        Enriched route candidates with risk information.
    """

    # Imported here so the routing module still loads
    # if ml_service is unavailable or has a circular import.
    from ml_service import (
        get_random_forest_model_status,
        predict_disturbance_risk
    )

    if not isinstance(routes, list) or not routes:
        raise ValueError("At least one route candidate is required.")

    if not isinstance(route_conditions, dict):
        raise ValueError("route_conditions must be a dictionary.")

    # Check whether the verified model is available.
    ml_available = False
    ml_status = {
        "trained": False,
        "message": "ML prediction not enabled."
    }

    if use_verified_ml:

        try:
            ml_status = get_random_forest_model_status(
                model_type="verified"
            )

            ml_available = bool(
                ml_status.get("trained", False)
            )

        except Exception as error:
            ml_status = {
                "trained": False,
                "message": str(error)
            }

    enriched_routes = []

    required_fields = [
        "temperature",
        "rainfall",
        "wind_speed",
        "severe_weather",
        "festival_nearby",
        "rss_disturbance",
        "weather_risk",
        "festival_risk",
        "strike_risk",
        "road_disruption_risk"
    ]

    for route in routes:

        route_id = route.get("route_id")
        conditions = route_conditions.get(route_id)

        enriched = dict(route)

        enriched["conditions_available"] = False
        enriched["ml_prediction"] = None
        enriched["ml_model_used"] = False
        enriched["ml_is_calibrated"] = False
        enriched["risk_score"] = None
        enriched["risk_level"] = "Unknown"
        enriched["condition_errors"] = []

        if not isinstance(conditions, dict):

            enriched["condition_errors"].append(
                "No condition data supplied for this route."
            )

            enriched_routes.append(enriched)
            continue

        missing = [
            field for field in required_fields
            if field not in conditions or conditions[field] is None
        ]

        if missing:

            enriched["condition_errors"].append(
                "Missing condition fields: " + ", ".join(missing)
            )

            enriched_routes.append(enriched)
            continue

        try:

            numeric_fields = [
                "temperature",
                "rainfall",
                "wind_speed",
                "weather_risk",
                "festival_risk",
                "strike_risk",
                "road_disruption_risk"
            ]

            values = {}

            for field in numeric_fields:

                value = float(conditions[field])

                if not math.isfinite(value):
                    raise ValueError(
                        f"{field} must be finite."
                    )

                values[field] = value

            if values["rainfall"] < 0 or values["wind_speed"] < 0:
                raise ValueError(
                    "Rainfall and wind speed cannot be negative."
                )

            for field in [
                "weather_risk",
                "festival_risk",
                "strike_risk",
                "road_disruption_risk"
            ]:

                if not 0 <= values[field] <= 100:
                    raise ValueError(
                        f"{field} must be between 0 and 100."
                    )

            for field in [
                "severe_weather",
                "festival_nearby",
                "rss_disturbance"
            ]:

                if int(conditions[field]) not in (0, 1):
                    raise ValueError(
                        f"{field} must be 0 or 1."
                    )

            # Existing weighted rule-based risk calculation.
            rule_result = calculate_route_risk(
                weather_risk=values["weather_risk"],
                festival_risk=values["festival_risk"],
                strike_risk=values["strike_risk"],
                road_disruption_risk=values["road_disruption_risk"]
            )

            rule_risk = float(rule_result["risk_score"])

            enriched["rule_based_risk"] = rule_risk
            enriched["rule_based_risk_level"] = (
                rule_result["risk_level"]
            )

            enriched["conditions_available"] = True

            # Use the verified model only.
            # Synthetic demonstration models are deliberately excluded.
            if ml_available:

                ml_features = {
                    "distance_km": float(
                        route.get("distance_km", 0)
                    ),
                    "temperature": values["temperature"],
                    "rainfall": values["rainfall"],
                    "wind_speed": values["wind_speed"],
                    "severe_weather": int(
                        conditions["severe_weather"]
                    ),
                    "festival_nearby": int(
                        conditions["festival_nearby"]
                    ),
                    "rss_disturbance": int(
                        conditions["rss_disturbance"]
                    )
                }

                prediction = predict_disturbance_risk(
                    ml_features,
                    model_type="verified"
                )

                ml_risk = float(
                    prediction["risk_percentage"]
                )

                # Equal contribution from the rule-based score
                # and the verified-data model's development score.
                # This is a combined decision score, NOT a calibrated
                # probability of a shipment being delayed.
                final_risk = (rule_risk + ml_risk) / 2

                enriched["ml_prediction"] = prediction
                enriched["ml_model_used"] = True
                enriched["ml_is_calibrated"] = False
                enriched["ml_risk_percentage"] = ml_risk

            else:

                final_risk = rule_risk

                enriched["ml_model_message"] = (
                    ml_status.get(
                        "message",
                        "Verified ML model is not trained."
                    )
                )

            if final_risk < 20:
                risk_level = "Low"
            elif final_risk < 40:
                risk_level = "Moderate"
            elif final_risk < 70:
                risk_level = "High"
            else:
                risk_level = "Severe"

            enriched["risk_score"] = round(
                final_risk, 2
            )

            enriched["risk_level"] = risk_level

            enriched["condition_data"] = dict(conditions)

        except Exception as error:

            enriched["condition_errors"].append(
                str(error)
            )

        enriched_routes.append(enriched)

    return enriched_routes