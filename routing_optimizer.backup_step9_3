"""
Day 5 - Intelligent Routing Engine
Shipment Management System

Contents
--------
Step 1 : OSRM route candidates, shortest route
Step 2 : Delay prediction (rule-based baseline)
Step 3 : Revised ETA calculation
Step 4 : Shortest vs fastest route comparison
Step 5 : Disturbance-aware route risk engine
Step 6 : Intelligent multi-criteria route ranking
Step 7 : Integration of real route conditions (verified ML + rules)
"""

import math
import requests

from datetime import datetime, timedelta, timezone
from typing import Optional


OSRM_ROUTE_URL = "https://router.project-osrm.org/route/v1/driving"

REQUEST_HEADERS = {
    "User-Agent": "ShipmentManagementSystem/1.0"
}


# ============================================================
# DAY 5 - STEP 1: ROUTE CANDIDATE GENERATION
# ============================================================

def validate_coordinates(location, location_name="Location"):
    """
    Validate coordinates supplied as (latitude, longitude).
    """

    if not isinstance(location, (tuple, list)) or len(location) != 2:
        raise ValueError(
            f"{location_name} must contain latitude and longitude."
        )

    latitude = float(location[0])
    longitude = float(location[1])

    if not math.isfinite(latitude) or not math.isfinite(longitude):
        raise ValueError(f"{location_name} contains invalid coordinates.")

    if not -90 <= latitude <= 90:
        raise ValueError(f"Invalid latitude for {location_name}.")

    if not -180 <= longitude <= 180:
        raise ValueError(f"Invalid longitude for {location_name}.")

    return latitude, longitude


def haversine_distance(point1, point2):
    """
    Calculate the straight-line distance between two coordinates.
    Returns kilometers.
    """

    lat1, lon1 = validate_coordinates(point1, "Point 1")
    lat2, lon2 = validate_coordinates(point2, "Point 2")

    radius = 6371.0

    lat1 = math.radians(lat1)
    lon1 = math.radians(lon1)
    lat2 = math.radians(lat2)
    lon2 = math.radians(lon2)

    dlat = lat2 - lat1
    dlon = lon2 - lon1

    a = (
        math.sin(dlat / 2) ** 2
        + math.cos(lat1)
        * math.cos(lat2)
        * math.sin(dlon / 2) ** 2
    )

    return 2 * radius * math.asin(math.sqrt(a))


def generate_route_candidates(
    source,
    destination,
    alternatives=3,
    timeout=30
):
    """
    Generate multiple driving route candidates using OSRM.

    Parameters
    ----------
    source:
        (latitude, longitude)

    destination:
        (latitude, longitude)

    alternatives:
        Maximum number of alternative routes requested.

    timeout:
        HTTP request timeout in seconds.

    Returns
    -------
    List of route dictionaries.
    """

    source_lat, source_lon = validate_coordinates(
        source, "Source"
    )

    destination_lat, destination_lon = validate_coordinates(
        destination, "Destination"
    )

    if source_lat == destination_lat and source_lon == destination_lon:
        raise ValueError(
            "Source and destination coordinates cannot be identical."
        )

    if not isinstance(alternatives, int) or not 1 <= alternatives <= 5:
        raise ValueError(
            "Alternatives must be an integer between 1 and 5."
        )

    # OSRM expects longitude,latitude.
    url_coordinates = (
        f"{source_lon},{source_lat};"
        f"{destination_lon},{destination_lat}"
    )

    url = f"{OSRM_ROUTE_URL}/{url_coordinates}"

    params = {
        "alternatives": alternatives,
        "steps": "false",
        "overview": "full",
        "geometries": "geojson"
    }

    try:
        response = requests.get(
            url,
            params=params,
            headers=REQUEST_HEADERS,
            timeout=timeout
        )

        response.raise_for_status()

        data = response.json()

    except requests.exceptions.Timeout as exc:
        raise RuntimeError(
            "OSRM routing request timed out. Please try again."
        ) from exc

    except requests.exceptions.RequestException as exc:
        raise RuntimeError(
            f"Unable to connect to OSRM routing service: {exc}"
        ) from exc

    except ValueError as exc:
        raise RuntimeError(
            "OSRM returned an invalid response."
        ) from exc

    if data.get("code") != "Ok":
        raise RuntimeError(
            f"OSRM could not generate a route: "
            f"{data.get('message', data.get('code', 'Unknown error'))}"
        )

    osrm_routes = data.get("routes", [])

    if not osrm_routes:
        raise RuntimeError(
            "No driving routes were found between these locations."
        )

    candidates = []

    for index, route in enumerate(osrm_routes):

        try:
            distance_meters = float(route["distance"])
            duration_seconds = float(route["duration"])

            geometry_coordinates = route["geometry"]["coordinates"]

            if distance_meters <= 0 or duration_seconds < 0:
                continue

            # OSRM GeoJSON uses [longitude, latitude].
            route_points = []

            for coordinate in geometry_coordinates:

                if len(coordinate) < 2:
                    continue

                longitude = float(coordinate[0])
                latitude = float(coordinate[1])

                point = validate_coordinates(
                    (latitude, longitude),
                    "Route point"
                )

                route_points.append(point)

            if len(route_points) < 2:
                continue

            candidates.append({
                "route_id": f"route_{index + 1}",

                "route_name": f"Route {index + 1}",

                "distance_km": round(
                    distance_meters / 1000, 2
                ),

                "duration_minutes": round(
                    duration_seconds / 60, 2
                ),

                "duration_seconds": round(
                    duration_seconds, 2
                ),

                "geometry": route_points,

                # Alias for compatibility with existing map functions.
                "points": route_points,

                "is_shortest": False,

                "source": (source_lat, source_lon),

                "destination": (
                    destination_lat,
                    destination_lon
                )
            })

        except (KeyError, TypeError, ValueError, IndexError):
            # Ignore malformed individual routes.
            continue

    if not candidates:
        raise RuntimeError(
            "OSRM returned routes, but none contained valid geometry."
        )

    # Identify the shortest available route.
    shortest_index = min(
        range(len(candidates)),
        key=lambda i: candidates[i]["distance_km"]
    )

    candidates[shortest_index]["is_shortest"] = True

    return candidates


def generate_shortest_route(source, destination):
    """
    Return the shortest-distance route from available OSRM candidates.
    """

    candidates = generate_route_candidates(
        source,
        destination,
        alternatives=3
    )

    shortest_route = min(
        candidates,
        key=lambda route: route["distance_km"]
    )

    return shortest_route


def calculate_route_summary(routes):
    """
    Create a summary of generated route candidates.
    """

    if not routes:
        return {
            "total_routes": 0,
            "shortest_distance_km": None,
            "fastest_duration_minutes": None
        }

    return {
        "total_routes": len(routes),

        "shortest_distance_km": min(
            route["distance_km"] for route in routes
        ),

        "fastest_duration_minutes": min(
            route["duration_minutes"] for route in routes
        )
    }


