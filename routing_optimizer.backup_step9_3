# DAY 5 - STEP 4: SHORTEST AND FASTEST ROUTE COMPARISON
# ============================================================

def generate_route_comparison(source, destination):
    """
    Generate available OSRM routes and compare:
    1. Shortest-distance route
    2. Fastest-time route

    Returns a dictionary containing both routes and comparison.
    """

    routes = generate_route_candidates(
        source,
        destination,
        alternatives=3
    )

    if not routes:
        raise RuntimeError("No routes available for comparison.")

    shortest_route = min(
        routes,
        key=lambda route: route["distance_km"]
    )

    fastest_route = min(
        routes,
        key=lambda route: route["duration_minutes"]
    )

    for route in routes:
        route["is_fastest"] = (
            route["route_id"] == fastest_route["route_id"]
        )

        route["is_shortest"] = (
            route["route_id"] == shortest_route["route_id"]
        )

    return {
        "routes": routes,

        "shortest_route": shortest_route,

        "fastest_route": fastest_route,

        "comparison": {
            "shortest_distance_km":
                shortest_route["distance_km"],

            "shortest_duration_minutes":
                shortest_route["duration_minutes"],

            "fastest_distance_km":
                fastest_route["distance_km"],

            "fastest_duration_minutes":
                fastest_route["duration_minutes"],

            "available_route_count": len(routes)
        }
    }


def calculate_route_difference(route1, route2):
    """
    Compare two route dictionaries.
    """

    if not isinstance(route1, dict) or not isinstance(route2, dict):
        raise TypeError("Both routes must be dictionaries.")

    required = ("distance_km", "duration_minutes")

    for key in required:
        if key not in route1 or key not in route2:
            raise ValueError(f"Both routes must contain {key}.")

        value1 = float(route1[key])
        value2 = float(route2[key])

        if not math.isfinite(value1) or not math.isfinite(value2):
            raise ValueError(f"Invalid {key} value.")

    distance_difference = (
        float(route2["distance_km"])
        - float(route1["distance_km"])
    )

    time_difference = (
        float(route2["duration_minutes"])
        - float(route1["duration_minutes"])
    )

    return {
        "distance_difference_km": round(
            distance_difference, 2
        ),

        "time_difference_minutes": round(
            time_difference, 2
        ),

        "route2_distance_change_percent": round(
            distance_difference
            / float(route1["distance_km"]) * 100,
            2
        ) if float(route1["distance_km"]) > 0 else None
    }


